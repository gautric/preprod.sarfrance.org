{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sarfrance.org/schemas/chronologie.schema.json",
  "title": "Chronologie SAR France",
  "type": "object",
  "required": ["periodes"],
  "additionalProperties": false,
  "properties": {
    "periodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/periode"}
    }
  },
  "$defs": {
    "periode": {
      "type": "object",
      "required": ["nom", "events"],
      "additionalProperties": false,
      "properties": {
        "nom": {"type": "string", "minLength": 1},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/event"}
        }
      }
    },
    "event": {
      "type": "object",
      "required": ["date", "titre"],
      "additionalProperties": false,
      "properties": {
        "date": {"type": "string", "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"},
        "titre": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "tags": {
          "description": "Clés déclarées dans data/metadata/chronologie.yaml (vérifié hors schéma).",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "wikipedia": {"type": "string"},
        "location": {"type": "string"},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    }
  }
}
