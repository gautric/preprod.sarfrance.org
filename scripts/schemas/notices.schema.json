{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sarfrance.org/schemas/notices.schema.json",
  "title": "Notices biographiques SAR France",
  "type": "object",
  "required": ["revision", "notices"],
  "additionalProperties": false,
  "properties": {
    "revision": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notices": {
      "type": "array",
      "items": {"$ref": "#/$defs/notice"}
    }
  },
  "$defs": {
    "notice": {
      "type": "object",
      "required": ["lastname", "role", "tags"],
      "additionalProperties": false,
      "properties": {
        "lastname": {"type": "string", "minLength": 1},
        "firstname": {"type": "string"},
        "particle": {"type": "string"},
        "role": {"type": "string", "minLength": 1},
        "tags": {
          "description": "Clés déclarées dans data/metadata/notices.yaml (vérifié hors schéma).",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        }
      }
    }
  }
}
