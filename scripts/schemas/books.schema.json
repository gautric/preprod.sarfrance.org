{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.sarfrance.org/schemas/books.schema.json",
  "title": "Bibliothèque SAR France",
  "type": "object",
  "required": ["revision", "books"],
  "additionalProperties": false,
  "properties": {
    "revision": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "books": {
      "type": "array",
      "items": {"$ref": "#/$defs/book"}
    }
  },
  "$defs": {
    "book": {
      "type": "object",
      "required": ["author", "name"],
      "additionalProperties": false,
      "properties": {
        "author": {
          "description": "Auteur du livre (peut être vide pour les œuvres collectives, anonymes ou les archives institutionnelles).",
          "type": "string"
        },
        "name": {"type": "string", "minLength": 1},
        "publisher": {"type": "string"},
        "datePublished": {"type": "string"},
        "inLanguage": {"type": "string"},
        "numberOfPages": {"type": ["integer", "string", "null"]},
        "bookFormat": {"type": "string"},
        "genre": {
          "description": "Clés déclarées dans data/metadata/books.yaml (vérifié hors schéma).",
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "isbn": {"type": "string"},
        "gallica": {"type": "string"},
        "source": {"type": "string"},
        "status": {"type": "string"},
        "description": {"type": "string"},
        "type": {
          "description": "Nature du support (ex. `media`). Facultatif.",
          "type": "string"
        }
      }
    }
  }
}
